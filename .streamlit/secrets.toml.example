# Copy to .streamlit/secrets.toml for local runs with Google Drive storage
# (or run: python tools/google_drive_auth.py --client-secrets client_secret.json --write-secrets)
EPD_STORAGE_BACKEND = "gdrive"
GDRIVE_CLIENT_ID = "xxxxxxxx.apps.googleusercontent.com"
GDRIVE_CLIENT_SECRET = "xxxxxxxx"
GDRIVE_REFRESH_TOKEN = "xxxxxxxx"
GDRIVE_FOLDER_NAME = "EPD_Prototype_Store"
